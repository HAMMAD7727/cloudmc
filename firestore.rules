/**
 * @fileoverview Firestore Security Rules for Cloudverse Store.
 *
 * Core Philosophy:
 * This ruleset provides role-based and key-based access control for the Cloudverse store,
 * balancing public readability with administrative control over sensitive data.
 *
 * Data Structure:
 * - /coin_packages/{coinPackageId}: Publicly readable coin package information.
 * - /ranks/{rankId}: Rank information, write access controlled by adminKey.
 * - /news_items/{newsItemId}: News items, write access controlled by adminKey.
 * - /feedback/{feedbackId}: Publicly writeable feedback submissions.
 * - /staff/{staffId}: Publicly readable staff member information, write access controlled by adminKey.
 * - /roles_admin/{userId}: Administrative user roles.
 *
 * Key Security Decisions:
 * - Public read access to coin_packages and staff collections.
 * - Admin-Key-based write access control for ranks, news_items, and staff collections.
 * - Unrestricted write access to feedback submissions.
 * - No user-based data segregation (all collections are top-level).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to coin packages and restricts writes.
     * @path /coin_packages/{coinPackageId}
     * @allow get, list: if true;
     * @allow create, update, delete: if false;
     * @principle Allows public listing and reading of coin packages.
     */
    match /coin_packages/{coinPackageId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants admin-key-based write access to rank information.
     * @path /ranks/{rankId}
     * @allow get, list: if true;
     * @allow create: if request.resource.data.adminKey == 'cloudmcstaff';
     * @allow update: if resource.data.adminKey == 'cloudmcstaff';
     * @allow delete: if resource.data.adminKey == 'cloudmcstaff';
     * @deny create: if request.resource.data.adminKey != 'cloudmcstaff';
     * @deny update: if resource.data.adminKey != 'cloudmcstaff';
     * @deny delete: if resource.data.adminKey != 'cloudmcstaff';
     * @principle Restricts write access to ranks based on a secret admin key.
     */
    match /ranks/{rankId} {
        allow get, list: if true;
        allow create: if request.resource.data.adminKey == 'cloudmcstaff';
        allow update: if resource.data.adminKey == 'cloudmcstaff';
        allow delete: if resource.data.adminKey == 'cloudmcstaff';
    }

    /**
     * @description Grants admin-key-based write access to news items.
     * @path /news_items/{newsItemId}
     * @allow get, list: if true;
     * @allow create: if request.resource.data.adminKey == 'cloudmcstaff';
     * @allow update: if resource.data.adminKey == 'cloudmcstaff';
     * @allow delete: if resource.data.adminKey == 'cloudmcstaff';
     * @deny create: if request.resource.data.adminKey != 'cloudmcstaff';
     * @deny update: if resource.data.adminKey != 'cloudmcstaff';
     * @deny delete: if resource.data.adminKey != 'cloudmcstaff';
     * @principle Restricts write access to news items based on a secret admin key.
     */
    match /news_items/{newsItemId} {
        allow get, list: if true;
        allow create: if request.resource.data.adminKey == 'cloudmcstaff';
        allow update: if resource.data.adminKey == 'cloudmcstaff';
        allow delete: if resource.data.adminKey == 'cloudmcstaff';
    }

    /**
     * @description Grants public write access to feedback submissions.
     * @path /feedback/{feedbackId}
     * @allow get, list, create, update, delete: if true;
     * @principle Allows anyone to submit feedback without authentication.
     */
    match /feedback/{feedbackId} {
      allow get, list, create, update, delete: if true;
    }

    /**
     * @description Grants public read access to staff information and admin-key-based write access.
     * @path /staff/{staffId}
     * @allow get, list: if true;
     * @allow create: if request.resource.data.adminKey == 'cloudmcstaff';
     * @allow update: if resource.data.adminKey == 'cloudmcstaff';
     * @allow delete: if resource.data.adminKey == 'cloudmcstaff';
     * @deny create: if request.resource.data.adminKey != 'cloudmcstaff';
     * @deny update: if resource.data.adminKey != 'cloudmcstaff';
     * @deny delete: if resource.data.adminKey != 'cloudmcstaff';
     * @principle Restricts write access to staff information based on a secret admin key.
     */
    match /staff/{staffId} {
        allow get, list: if true;
        allow create: if request.resource.data.adminKey == 'cloudmcstaff';
        allow update: if request.resource.data.adminKey == 'cloudmcstaff';
        allow delete: if request.resource.data.adminKey == 'cloudmcstaff';
    }

    /**
     * @description Grants write access to roles_admin for a specific user.
     * @path /roles_admin/{userId}
     * @allow get, list: if false;
     * @allow create, update, delete: if false;
     * @principle Restricts access to admin roles based on user authentication.
     */
    match /roles_admin/{userId} {
        allow get, list: if false;
        allow create, update, delete: if false;
    }
  }
}